<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android TV home-row banner, on the same geometry as the sibling apps (PH TV, 91 TV): a flat
  #111111 field, the play mark in the app's own colour, and two white bars standing in for a
  wordmark. Only the colour differs between them.

  VectorRaster targets legacy compatibility rasterization; XTV is API 30+ and TV requires 320x180.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180"
    tools:ignore="VectorRaster">
    <path
        android:fillColor="#FF111111"
        android:pathData="M0,0 H320 V180 H0 Z" />
    <path
        android:fillColor="#FF1D9BF0"
        android:pathData="M132,64 L132,116 L180,90 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M196,78 h70 v6 h-70 z M196,92 h54 v6 h-54 z" />
</vector>
