<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a TextureView rather than the default SurfaceView.

  A reel cuts between portrait and landscape video constantly, and a SurfaceView keeps the surface
  sized for the *previous* item until the new video size event lands — which shows up as a landscape
  clip squashed into the previous portrait frame. A TextureView re-applies the video transform matrix
  every frame, so it cannot get stuck on a stale size. `surface_type` is only settable from XML, hence
  this layout; everything else (controller, focus) is configured in ReelViewer.

  Same fix as the sibling PHTV app, which hit the identical glitch.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:use_controller="false" />
