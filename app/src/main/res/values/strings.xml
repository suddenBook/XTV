<?xml version="1.0" encoding="utf-8"?>
<!-- Default (English). Android picks values-zh-rCN / values-zh-rTW automatically from the system
     locale; there is deliberately no in-app language switcher.

     Two rules hold across this file:

     1. No string is assembled from other strings. Every message is one complete sentence with its
        own placeholders, even where that means four near-identical entries, because a separator
        baked into a resource ("   ·   ") is a layout decision hiding in a translation file.
     2. Nothing here names a part of the machine. "reel", "reservation", "offer", "candidate",
        "cursor" and "journal" are precise words for the code to use about itself; on screen they
        answer a question nobody asked. -->
<resources>
    <string name="app_name" translatable="false">X TV</string>
    <string name="repo_url" translatable="false">github.com/suddenBook/XTV</string>

    <!-- Provisioning: a transient, DUMP-protected panel driven from a terminal. The operator is at
         a keyboard, so the raw rejection reason is the most useful thing it can show. -->
    <string name="provisioning_in_progress">Checking credentials…</string>
    <string name="provisioning_complete">Setup complete</string>
    <string name="provisioning_failed">Setup failed: %1$s</string>

    <!-- Setup: two presentations, five internal states. Every state on the left of the divide is
         fixed by the same action — run the setup script again from a computer — so telling them
         apart on screen would only be telling the user about the state machine. The wording must
         stay true for an install that holds a client id and a live session but no bearer, which is
         why it says "no usable credentials" and not "not set up yet". -->
    <string name="setup_needed_title">Setup needed</string>
    <string name="setup_needed_body">This device has no usable X credentials, so it cannot fetch anything. Setup runs once, from a computer over ADB.</string>
    <string name="setup_resume_hint">A previous setup was interrupted. Running the same command again picks up where it stopped.</string>
    <string name="setup_scan">Scan for the full instructions</string>

    <string name="setup_broken_title">Local data can\'t be read</string>
    <string name="setup_broken_body">The encryption key is no longer valid. XTV stopped before making any network request. Clearing the local data and setting up again is the only way forward.</string>
    <string name="setup_clear">Clear and start over</string>
    <string name="setup_clear_failed">Clearing failed. Nothing was sent; try again or check device storage.</string>

    <!-- Home -->
    <string name="home_continue">Continue watching</string>
    <string name="home_replay">Watch again from the start</string>
    <plurals name="home_replay_sub">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>
    <string name="home_get_new">Get new videos</string>
    <plurals name="home_all">
        <item quantity="one">All %1$d</item>
        <item quantity="other">All %1$d</item>
    </plurals>
    <string name="home_settings">Settings</string>
    <string name="home_diagnostics">Diagnostics</string>

    <!-- Offers. Always these three sizes. The price is a range because the exact charge depends on
         what X returns: the low end is the measured expectation, the high end is a conservative
         upper bound, and the bill never exceeds it. -->
    <string name="size_short">Short</string>
    <string name="size_standard">Standard</string>
    <string name="size_long">Long</string>
    <plurals name="offer_videos">
        <item quantity="one">about %1$d video</item>
        <item quantity="other">about %1$d videos</item>
    </plurals>
    <string name="offer_price_range">%1$s - %2$s</string>

    <!-- Exit -->
    <string name="exit_title">Leave X TV?</string>
    <string name="exit_body">Your place is saved.</string>
    <string name="exit_confirm">Exit</string>
    <string name="exit_cancel">Cancel</string>

    <!-- Player. Skipped items are deliberately not counted back at the viewer: they skipped them on
         purpose. Failures are reported, because those were not their choice. -->
    <string name="reel_done_title">That\'s all</string>
    <plurals name="reel_done_played">
        <item quantity="one">%1$d video played</item>
        <item quantity="other">%1$d videos played</item>
    </plurals>
    <plurals name="reel_done_played_with_failures">
        <item quantity="one">%1$d played · %2$d couldn\'t load</item>
        <item quantity="other">%1$d played · %2$d couldn\'t load</item>
    </plurals>
    <string name="reel_done_hint">OK to watch again · BACK to go home</string>
    <string name="reel_empty">Nothing to play</string>
    <plurals name="reel_failures">
        <item quantity="one">%1$d in a row couldn\'t load</item>
        <item quantity="other">%1$d in a row couldn\'t load</item>
    </plurals>
    <string name="reel_checkpoint_warning">Playing on, but your place isn\'t being saved</string>
    <string name="reel_partial_warning">This batch is incomplete — playing what arrived</string>
    <string name="seek_back">−10s</string>
    <string name="seek_forward">+10s</string>

    <!-- Grid -->
    <string name="grid_title">All videos</string>
    <plurals name="grid_count">
        <item quantity="one">%1$d video</item>
        <item quantity="other">%1$d videos</item>
    </plurals>
    <string name="grid_next">Next</string>
    <string name="grid_watched">Watched</string>

    <!-- Settings: the one screen where money belongs. -->
    <string name="settings_title">Settings</string>
    <string name="settings_usage_label">X project usage</string>
    <string name="settings_tile_posts">Post reads</string>
    <string name="settings_tile_posts_value">%1$,d</string>
    <string name="settings_tile_cost">Estimated cost</string>
    <string name="settings_tile_reset">Resets</string>
    <string name="settings_tile_reset_value">Day %1$d</string>
    <string name="settings_usage_note">X\'s own reporting period, across the whole developer project — including anything else using these credentials.</string>
    <string name="settings_usage_refresh">Refresh</string>
    <string name="settings_reset_credentials">Reset credentials</string>
    <string name="settings_reset_everything">Erase everything</string>
    <string name="settings_reset_credentials_title">Reset credentials?</string>
    <string name="settings_reset_credentials_body">Removes the credentials and the current session. Your videos are kept, so setting up the same account again restores them.</string>
    <string name="settings_reset_everything_title">Erase everything?</string>
    <string name="settings_reset_everything_body">Permanently removes the credentials, your videos and your place in them. This cannot be undone.</string>
    <string name="settings_reset_confirm">Erase</string>
    <string name="settings_reset_blocked">Something else is running. Try again in a moment.</string>

    <!-- The precise credential state, kept as one quiet line on the setup screen rather than five
         paragraphs. It cannot live in diagnostics: that screen is only reachable from home, and
         home is only reachable once the credentials are complete, so the line would forever read
         "Complete". Which of the three values failed to take is genuinely useful to the operator
         who has just run the script. The detail strings stand alone — prefixing them with a label
         would be assembling a sentence from two resources, which this file does not do. -->
    <string name="credential_state_client_id">Client ID missing</string>
    <string name="credential_state_bearer">Bearer token missing</string>
    <string name="credential_state_session">Session expired</string>
    <string name="credential_state_provisioning">Setup unfinished</string>
    <string name="credential_state_private_state">Local data unreadable</string>

    <!-- Diagnostics: the log, and the one build fact that explains a price. -->
    <string name="diagnostics_title">Diagnostics</string>
    <string name="diagnostics_rate_card">Rate card %1$s</string>
    <string name="diagnostics_log_label">Recent requests</string>
    <string name="diagnostics_empty">Nothing recorded yet.</string>

    <!-- Notices, in three weights.
         Brief   — it will pass on its own; the message clears itself.
         Standing— it will not pass until someone acts elsewhere; it stays.
         Loud    — money left the account and the viewer has nothing to show for it. -->
    <string name="notice_working">Getting videos…</string>
    <string name="notice_busy">Still finishing the last request…</string>

    <string name="notice_rate_limited">X is rate limiting — try again shortly</string>
    <string name="notice_network">Couldn\'t confirm the result; nothing was retried automatically</string>
    <string name="notice_offer_expired">That option expired — pick one of the current ones</string>
    <string name="notice_state_changed">The account or the pricing changed — pick again</string>

    <string name="notice_no_credits">The X project is out of API credits</string>
    <string name="notice_upstream_changed">X changed its API — this version can\'t fetch for now</string>
    <string name="notice_unexpected">That didn\'t finish. It may still have been charged.</string>

    <string name="notice_no_videos_title">No videos this time</string>
    <plurals name="notice_no_videos_body">
        <item quantity="one">Read %1$d post and it carried no video. You were still charged.</item>
        <item quantity="other">Read %1$d posts and none carried video. You were still charged.</item>
    </plurals>
    <string name="notice_interrupted_title">Request interrupted</string>
    <string name="notice_interrupted_body">XTV can\'t tell whether it was billed, so it recorded the worst case: %1$s.</string>
    <string name="notice_dismiss">OK</string>
    <!-- A partial batch is deliberately not announced here. The player already says so over the
         video it is playing, and being told the same thing twice for one event reads as two
         problems. -->

</resources>
